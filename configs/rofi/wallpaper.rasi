@import "themes/colors.rasi"

configuration {
    drun-display-format: "{icon}";
}
window {
    transparency:           "real";
    background-color:       @bg;
    text-color:             @fg;
    border:                 3px;
    border-color:           @fg-alt;
    width:                  650px;
    location:               center;
}
mainbox {
    background-color:       transparent;
    orientation:            vertical;
    children:               [ "listview" ];
}
listview {
    background-color:       transparent;
    columns:                4;
    lines:                  3;
    cycle:                  true;
    dynamic:                true;
    scrollbar:              false;
    layout:                 vertical;
    flow:                   horizontal;
    padding:                6px;
}
element {
    background-color:       transparent;
    text-color:             @fg;
    orientation:            vertical;   
    padding:                6px;
    spacing:                0px;
    children:               [ "element-icon" ];
    cursor:                 "default";
}
element normal.normal {
    background-color:       transparent;
    text-color:             @fg;
}
element selected.normal {
    background-color:       @bg-alt;
    text-color:             @hl;
    border:                 2px;
    border-color:           @fg-alt;
}
element-icon {
    background-color:       transparent;
    horizontal-align:       0.5;
    vertical-align:         0.5;
    width:                  190px;
    height:                 106px;
    size:                   126px; 
    cursor:                 inherit;
}
element-text {
    enabled:                false;
}
