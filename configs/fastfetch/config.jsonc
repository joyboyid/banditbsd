{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/space.txt",
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": " 󰅂 ",
        "color": {
            "keys": "magenta",
            "title": "magenta"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "Hi \u001b[32m{1}\u001b[0m@\u001b[32m{2}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "────────────────────────────────────"
        },
        {
            "type": "os",
            "key": "󰣇 OS"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel"
        },
        {
            "type": "wm",
            "key": "󱂬 WM"
        },
        {
            "type": "shell",
            "key": "󰞷 Shell"
        },
        {
            "type": "terminal",
            "key": "󰞍 Terminal"
        },
        {
            "type": "uptime",
            "key": "󰥔 Uptime"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },
        {
            "type": "custom",
            "format": "────────────────────────────────────"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
